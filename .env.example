# VisionGuard AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real credentials to version control.

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://visionguard:password@localhost:5432/visionguard
# For SQLite (development only):
# DATABASE_URL=sqlite:///./visionguard.db

# Security — GENERATE SECURE RANDOM VALUES
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-ME-TO-A-SECURE-RANDOM-STRING
JWT_SECRET=CHANGE-ME-TO-A-DIFFERENT-SECURE-RANDOM-STRING

# Token expiration (minutes, default: 1440 = 24 hours)
TOKEN_EXPIRE_MINUTES=1440

# CORS — Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Evidence storage
EVIDENCE_DIR=./evidence
EVIDENCE_RETENTION_DAYS=30

# Model configuration
MODEL_NAME=coco-ssd
MODEL_PATH=
USE_TENSORRT=false

# Debug mode (never enable in production)
DEBUG=false

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Backend API URL (used by frontend to connect to backend)
VITE_API_URL=http://localhost:8000

# ============================================
# DOCKER COMPOSE (if using docker-compose.yml)
# ============================================

DB_USER=visionguard
DB_PASSWORD=CHANGE-ME-TO-A-SECURE-PASSWORD

# ============================================
# NVIDIA GPU / TENSORRT (optional)
# ============================================

# Set to true if running on NVIDIA GPU with TensorRT installed
# USE_TENSORRT=true
# CUDA_VISIBLE_DEVICES=0
